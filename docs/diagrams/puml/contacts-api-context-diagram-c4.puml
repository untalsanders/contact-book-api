@startuml "Contacts API - Context Diagram C4Model"
!include styles.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_TOP_DOWN()
HIDE_STEREOTYPE()


' Tags support no spaces in the name (based on the underlining stereotypes, which don't support spaces anymore).
AddElementTag("softwareSystem", $fontColor=$ELEMENT_FONT_COLOR, $bgColor="#1168bd", $legendText="software system")
AddRelTag("async", $textColor=$ARROW_FONT_COLOR, $lineColor=$ARROW_COLOR, $lineStyle=DashedLine())

title Context Diagram MS-Contacts

SHOW_PERSON_OUTLINE()

Person(customer, User, "The user who uses the contacts application.", $sprite="person", $type="Person")
System(contacts_system, "MS-Contacts\n<size:10>[Software System]</size>", "It allows the management of a contact list.", $tags="softwareSystem")
System_Ext(mail, "E-mail System", "Internal E-mail exchange software.")

Rel(customer, contacts_system, "Create, edit or delete contacts.")
Rel_Back(customer, mail, "Send e-mails to", $tags="async")
Rel_Neighbor(contacts_system, mail, "Send e-mails", "SMTP", $tags="async")

SHOW_FLOATING_LEGEND()

caption \nFigure 1: [Context of System] MS-Contacts
footer diagram created with PlantUML v. %version() y C4-PlantUML v. C4Version()
@enduml
